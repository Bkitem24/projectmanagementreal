<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<!--
  Windows application manifest embedded into the built .exe (see build.rs)
  so it always runs elevated ("Run as administrator"), requested 2026-09-21.

  requireAdministrator makes Windows show the UAC elevation prompt every
  single time the app is launched, and refuse to launch at all if the
  person declines it - this is a real behavior change, not a cosmetic one,
  so it's only worth doing with a real reason. Humayun asked for it "just
  to avoid any other issues" after confirming every employee runs this on
  their own personal home PC (not a locked-down/managed work machine) -
  under that condition there's no real downside (no separate admin account
  to juggle, no corporate policy blocking it), and it heads off a category
  of hard-to-diagnose bugs before they ever get reported: the global
  keyboard/mouse hook (rdev, src/timelog.rs) and screen capture (xcap) this
  app relies on for TimeLog activity tracking can behave inconsistently or
  fail outright without elevation on some Windows configurations, and only
  admin-elevated processes can ever set a global hook that also sees
  keystrokes typed into ANOTHER elevated (admin) window - a real gap
  otherwise, e.g. if an employee runs some other tool as admin.

  IMPORTANT - fixed 2026-09-21 (first attempt broke the app entirely): a
  custom app_manifest() REPLACES Tauri's own default manifest outright, it
  doesn't merge with it. Tauri's default manifest (tauri-build's own
  windows-app-manifest.xml) exists specifically to declare a dependency on
  the modern Common Controls v6 library - without it, Windows loads the
  ancient system default (v5.82) instead, which is missing newer APIs
  entirely. That's exactly what caused "The procedure entry point
  TaskDialogIndirect could not be located" on launch: the first version of
  this file only had the elevation block below and silently dropped that
  dependency. Both pieces have to live in the same manifest, so this file
  now carries both - the Common Controls v6 dependency (copied verbatim
  from tauri-build's own default) AND the elevation request.
-->
<assembly xmlns="urn:schemas-microsoft-com:asm.v1" manifestVersion="1.0">
  <dependency>
    <dependentAssembly>
      <assemblyIdentity
        type="win32"
        name="Microsoft.Windows.Common-Controls"
        version="6.0.0.0"
        processorArchitecture="*"
        publicKeyToken="6595b64144ccf1df"
        language="*"
      />
    </dependentAssembly>
  </dependency>
  <trustInfo xmlns="urn:schemas-microsoft-com:asm.v3">
    <security>
      <requestedPrivileges>
        <requestedExecutionLevel level="requireAdministrator" uiAccess="false" />
      </requestedPrivileges>
    </security>
  </trustInfo>
</assembly>
