# Copy this file to .env and fill in your own Supabase project values.
# Find these in your Supabase project: Settings -> API.
VITE_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key

# Cloudflare R2 file-upload worker (worker-r2/) — avatars, client photos,
# task attachments, and TimeLog screenshots all go through this. Leave blank
# to run without file uploads; see README.md section 4 to set it up.
VITE_R2_UPLOAD_WORKER_URL=

# Cloudflare Realtime worker (worker-realtime/) — powers "Connect" voice
# huddles. Leave blank and Connect's presence/ring UI still works, but
# starting an actual call will show "not configured yet". See README.md
# section 5.
VITE_REALTIME_WORKER_URL=
