# Copy this file to .env and fill in your own Supabase project values.
# Find these in your Supabase project: Settings -> API.
VITE_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key

# All four *_WORKER_URL values below must include the https:// scheme
# (e.g. https://your-worker.your-subdomain.workers.dev) - Connect/Meetings
# explicitly check for it and will show "not configured" without it, and
# R2/music will silently fail (treated as a relative URL) instead.
#
# Cloudflare R2 file-upload worker (worker-r2/) — avatars, client photos,
# task attachments, and TimeLog screenshots all go through this. Leave blank
# to run without file uploads; see README.md section 4 to set it up.
VITE_R2_UPLOAD_WORKER_URL=

# Cloudflare Realtime worker (worker-realtime/) — powers "Connect" voice
# huddles. Leave blank and Connect's presence/ring UI still works, but
# starting an actual call will show "not configured yet". See README.md
# section 5.
VITE_REALTIME_WORKER_URL=

# Cloudflare Realtime worker (worker-meetings/) — powers "Meetings" (video
# calls, screen share, host recording) - a SEPARATE feature/Worker from
# Connect above, though it reuses the same Cloudflare Realtime App ID/
# Token. Leave blank and Meetings shows "not configured yet". See
# README.md section 6.
VITE_MEETINGS_WORKER_URL=

# Cloudflare Worker that streams the in-app music player's library out of
# a shared Google Drive folder (worker-drive-music/) — replaces the old
# YouTube-embed player. Leave blank and the music widget just shows "no
# tracks" instead of erroring. See worker-drive-music/wrangler.toml for the
# one-time Google Cloud service-account setup this depends on.
VITE_DRIVE_MUSIC_WORKER_URL=
